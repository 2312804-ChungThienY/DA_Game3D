  m_Script: {fileID: 11500000, guid: 7ffa6a3ef8973f84f81daebcb047ee92, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::RelicAltar
  worldState: {fileID: 9300000002}
  saveService: {fileID: 9400000000}
  storyPanel: {fileID: 1938697837}
  restoredVisual: {fileID: 524135954}
  readyGlow: {fileID: 227294544}
  fragmentIds:
  - relic_drum_a
  - relic_drum_b
  - relic_drum_c
  bossId: guardian_01
  bossName: "H\u1ED9 v\u1EC7 \u0110\xE1"
  restoredId: c1_relic_restored
  relicName: "Tr\u1ED1ng \u0110\u1ED3ng"
  grantAbility: movement_kit
  checkpointId: cp_kim_quy
  endsChapter: 1
  nextScene: 03_GiengTroiChimLac
  nextCheckpoint: c2_cp_start
  endTitle: "Ch\u01B0\u01A1ng 1 ho\xE0n th\xE0nh \u2013 \u0110\xE0n Kim Quy"
  endBody: "Ba m\u1EA3nh Tr\u1ED1ng \u0110\u1ED3ng kh\u1EDBp l\u1EA1i. Ti\u1EBFng
    tr\u1ED1ng ng\xE2n qua l\xF2ng hang, linh m\u1EA1ch d\u01B0\u1EDBi \u0110\xE0n
    Kim Quy s\xE1ng tr\u1EDF l\u1EA1i v\xE0 H\u1EAFc S\u01B0\u01A1ng l\xF9i xa.\n\nKim
    Quy trao cho An <b>Ph\xFAc Kim Quy</b>: Ctrl tr\xE1i + h\u01B0\u1EDBng \u0111\u1EC3
    l\u1ED9n n\xE9, l\u1ED9n r\u1ED3i ch\xE9m \u0111\u1EC3 \u0111\xE2m t\u1EDBi.
    Kim Quy d\u1EB7n: \u201CKhi g\u1EB7p tr\u1ED1ng b\u1ED1n v\xE0nh, v\xE0nh c\u1EE7a
    ta vang cu\u1ED1i c\xF9ng.\u201D\n\nM\u1ED9t lu\u1ED3ng gi\xF3 t\u1EEB khe \u0111\xE1
    \u0111\u01B0a xu\u1ED1ng chi\u1EBFc l\xF4ng v\xE0ng. An \u0111i theo lu\u1ED3ng
    gi\xF3 t\u1EDBi <b>Gi\u1EBFng Tr\u1EDDi Chim L\u1EA1c</b>; tr\xEAn cao, m\u1ED9t
    linh m\u1EA1ch kh\xE1c v\u1EABn \u0111ang b\u1ECB H\u1EAFc S\u01B0\u01A1ng che
    ph\u1EE7.\n\nTi\u1EBFn tr\xECnh \u0111\xE3 \u0111\u01B0\u1EE3c l\u01B0u t\u1EA1i
    b\u1EC7 Kim Quy. T\xFAi \u0111\u1ED3, L\u1ED3ng \u0110\xE8n Sen, Ph\xFAc Kim
    Quy v\xE0 nh\u1EEFng ghi ch\xE9p s\u1EBD theo An sang ch\u01B0\u01A1ng ti\u1EBFp
    theo."
  onRestored:
    m_PersistentCalls:
      m_Calls: []
  restorationCard: {fileID: 0}

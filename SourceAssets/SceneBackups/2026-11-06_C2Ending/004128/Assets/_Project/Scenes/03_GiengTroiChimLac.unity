  m_Script: {fileID: 11500000, guid: b101651c6edd76b4694793a556fd87bd, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::ChapterQuestTracker
  worldState: {fileID: 9300000002}
  objectiveText: {fileID: 9300000022}
  doneText: "Ch\u01B0\u01A1ng 2 ho\xE0n th\xE0nh.\n\u0110i qua c\u1ED5ng gi\xF3 ph\xEDa
    t\xE2y \u0111\u1EC9nh t\u1ED5."
  steps:
  - text: "Nh\u1EADn L\xF4ng Chim L\u1EA1c (E).\nTheo kho\u1EA3ng s\xE1ng tr\u01B0\u1EDBc
      m\u1EB7t."
    requirements:
    - set: 7
      id: ability_wind
      displayName: ability_wind
  - text: "D\xF9ng c\u1ED9t gi\xF3 b\xEAn ph\u1EA3i \u0111\u1EC3 l\xEAn g\u1EDD.\n\u0110\u1ECDc
      bia v\xE0 nh\u1EADn m\u1EA3nh \u0111\u1EA7u ti\xEAn."
    requirements:
    - set: 0
      id: c2_frag_1
      displayName: c2_frag_1
  - text: "V\u01B0\u1EE3t V\xE1ch Gi\xF3 b\u1EB1ng hai c\u1ED9t gi\xF3,\nl\u1EA5y
      m\u1EA3nh 2 tr\xEAn b\u1EC7 cao."
    requirements:
    - set: 0
      id: c2_frag_2
      displayName: c2_frag_2
  - text: "R\u1ECDi \u0111\xE8n \u0111\u1ECDc ph\xF9 \u0111i\xEAu,\ng\xF5 chu\xF4ng
      gi\xF3 theo th\u1EE9 t\u1EF1."
    requirements:
    - set: 1
      id: c2_pz_chuong_gio
      displayName: c2_pz_chuong_gio
  - text: "L\xEAn g\u1EDD b\u1EB1ng c\u1ED9t gi\xF3 cu\u1ED1i, l\u1EA5y m\u1EA3nh
      3."
    requirements:
    - set: 0
      id: c2_frag_3
      displayName: c2_frag_3
  - text: "Qua C\u1EA7u M\xE2y G\xE3y, nh\u1EADn L\xF4ng Gi\xF3 L\u1EDBn."
    requirements:
    - set: 6
      id: c2_tool_long_gio_lon
      displayName: c2_tool_long_gio_lon
  - text: "Gi\u1EA3i tho\xE1t Chim L\u1EA1c: ch\u1EDD chim \u0111\u1EADu,\nl\xEAn
      c\u1ED9t gi\xF3 gi\u1EEFa v\xE0 r\u1ECDi \u0111\xE8n."
    requirements:
    - set: 5
      id: c2_boss_chim_lac
      displayName: c2_boss_chim_lac
  - text: "Ph\u1EE5c d\u1EF1ng M\u1EB7t Tr\u1EDDi L\xF4ng Chim t\u1EA1i b\u1EC7."
    requirements:
    - set: 1
      id: c2_relic_restored
      displayName: c2_relic_restored
  - text: "Tr\u1EA3 l\u1EDDi Chim L\u1EA1c."
    requirements:
    - set: 1
      id: c2_linhthan_done
      displayName: c2_linhthan_done

  fragmentIds:
  - relic_drum_a
  - relic_drum_b
  - relic_drum_c
  bossId: guardian_01
  bossName: "H\u1ED9 v\u1EC7 \u0110\xE1"
  restoredId: c1_relic_restored
  relicName: "Tr\u1ED1ng \u0110\u1ED3ng"
  grantAbility: movement_kit
  checkpointId: cp_kim_quy
  endsChapter: 1
  nextScene: 03_GiengTroiChimLac
  nextCheckpoint: c2_cp_start
  endTitle: "Ch\u01B0\u01A1ng 1 ho\xE0n th\xE0nh \u2013 \u0110\xE0n Kim Quy"
  endBody: "Ba m\u1EA3nh Tr\u1ED1ng \u0110\u1ED3ng kh\u1EDBp l\u1EA1i tr\xEAn b\u1EC7
    \u0111\xE1. Ti\u1EBFng tr\u1ED1ng ng\xE2n d\xE0i qua l\xF2ng hang, linh m\u1EA1ch
    d\u01B0\u1EDBi \u0110\xE0n Kim Quy s\xE1ng tr\u1EDF l\u1EA1i v\xE0 H\u1EAFc S\u01B0\u01A1ng
    l\xF9i xa.\n\nT\u1EEB m\u1EB7t n\u01B0\u1EDBc t\u1ED1i, b\xF3ng R\xF9a V\xE0ng
    hi\u1EC7n l\xEAn v\xE0 trao cho An Ph\xFAc Kim Quy: t\u1EEB nay An l\u1ED9n n\xE9
    \u0111\u01B0\u1EE3c (Ctrl + h\u01B0\u1EDBng), l\u1ED9n r\u1ED3i ch\xE9m, v\xE0
    n\xE9 \u0111\xFAng l\xFAc.\nKim Quy d\u1EB7n: \"Khi g\u1EB7p tr\u1ED1ng b\u1ED1n
    v\xE0nh, v\xE0nh c\u1EE7a ta vang cu\u1ED1i c\xF9ng.\"\n\nTruy\u1EC1n thuy\u1EBFt:
    Kim Quy gi\xFAp An D\u01B0\u01A1ng V\u01B0\u01A1ng x\xE2y th\xE0nh C\u1ED5 Loa.\n\nTi\u1EBFn
    tr\xECnh \u0111\xE3 \u0111\u01B0\u1EE3c l\u01B0u t\u1EA1i b\u1EC7 Kim Quy."
  onRestored:
    m_PersistentCalls:
      m_Calls: []

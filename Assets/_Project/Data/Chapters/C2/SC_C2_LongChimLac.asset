  m_Script: {fileID: 11500000, guid: 967e567dd881df54ea2610520bf952fc, type: 3}
  m_Name: SC_C2_LongChimLac
  m_EditorClassIdentifier: Assembly-CSharp::StoryCard
  title: "L\xF4ng Chim L\u1EA1c"
  body: "Chi\u1EBFc l\xF4ng v\xE0ng s\xE1ng l\xEAn trong tay An. T\u1EEB nay An b\u01B0\u1EDBc
    v\xE0o c\u1ED9t gi\xF3 (v\u1EC7t xanh l\u01A1) s\u1EBD \u0111\u01B0\u1EE3c n\xE2ng
    l\xEAn cao v\xE0 l\u01A1 l\u1EEDng \u1EDF \u0111\u1EC9nh c\u1ED9t; nh\u1EA5n
    Space \u0111\u1EC3 nh\u1EA3y sang b\u1EC7.\n\nQu\xE0 Kim Quy: Ctrl + h\u01B0\u1EDBng
    \u0111\u1EC3 l\u1ED9n n\xE9 (t\u1ED1n 25 th\u1EC3 l\u1EF1c), ch\xE9m ngay sau
    khi l\u1ED9n \u0111\u1EC3 \u0111\xE2m t\u1EDBi, l\u1ED9n \u0111\xFAng l\xFAc
    \u0111\xF2n s\u1EAFp tr\xFAng \u0111\u1EC3 ch\u1EADm th\u1EDDi gian. Chu\u1ED9t
    gi\u1EEFa \u0111\u1EC3 kh\xF3a m\u1EE5c ti\xEAu."
  image: {fileID: 0}
